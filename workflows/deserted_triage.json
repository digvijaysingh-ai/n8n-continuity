      "id": "17f5c61c-bb8b-52d6-b1b9-1beaf694c028",
      "name": "Triage rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2720,
        220
      ],
      "parameters": {
        "jsCode": "// The triage log: one row per lot, so the same lot is never triaged twice.\nconst at = $now.toISO();\nreturn $input.all().map(it => ({ json: {\n  triaged_at: at, hospital: it.json.hospital, lot_key: it.json.lot_key, title: it.json.title,\n  outcome: it.json.outcome, bucket: it.json.triage.bucket, lever: it.json.triage.lever,\n  owner_role: it.json.owner_role, confidence: it.json.triage.confidence, why: it.json.triage.why,\n} }));"
      }
    },
