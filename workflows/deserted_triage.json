      "id": "2796d633-b9e0-5942-ade6-7d6d198d06eb",
      "name": "Group by tender",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        100
      ],
      "parameters": {
        "jsCode": "// Lots of one tender share a cause: triage the tender once, not each lot.\nconst groups = new Map();\nfor (const it of $input.all()) {\n  const l = it.json;\n  if (!groups.has(l.contract_ref)) groups.set(l.contract_ref, { ...l, lot_key: l.contract_ref, lots: 0, budget: 0 });\n  const g = groups.get(l.contract_ref);\n  g.lots += 1;\n  g.budget += l.budget ?? 0;\n}\nreturn [...groups.values()].map(json => ({ json }));"
      }
    },
